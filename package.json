{
  "name": "volkern-mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for Volkern CRM - Lead management, appointments, tasks, and WhatsApp messaging integration",
  "main": "dist/index.js",
  "bin": {
    "volkern-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "dev:http": "TRANSPORT=http npx tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "volkern",
    "crm",
    "leads",
    "appointments",
    "whatsapp",
    "claude",
    "ai-agent"
  ],
  "author": "Volkern <soporte@volkern.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeXpertmx/mcp-volkern"
  },
  "homepage": "https://volkern.app",
  "bugs": {
    "url": "https://github.com/DeXpertmx/mcp-volkern/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
